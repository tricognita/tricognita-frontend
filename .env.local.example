# Copy to .env.local for local dev. DO NOT COMMIT real values.
SENTINEL_JIT_SECRET=replace-with-32plus-byte-random-string-xxxxxxxxxxxxxxxx
DEMO_ADMIN_EMAIL=demo@tricognita.com
DEMO_ADMIN_PASSWORD=replace-with-strong-12plus-char-password
DEMO_ADMIN_NAME=Tricognita Admin

# Shared password for the 3 demo non-admin accounts (secops/auditor/viewer).
# Leave unset to skip seeding them.
DEMO_USERS_PASSWORD=replace-with-demo-12plus-char-password

# Go backend URL (local dev: http://localhost:8787, prod: your EC2/App Runner URL)
SENTINEL_API_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Threat Intelligence API keys (all optional — falls back to demo data if unset)
# ---------------------------------------------------------------------------
ABUSEIPDB_KEY=           # https://www.abuseipdb.com/account/api
VT_KEY=                  # https://www.virustotal.com/gui/my-apikey
GREYNOISE_KEY=           # https://viz.greynoise.io/account (community tier: free)
OTX_KEY=                 # https://otx.alienvault.com/api (free)

# ---------------------------------------------------------------------------
# Stripe billing (optional — skip for dev)
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=   # whsec_...

# ---------------------------------------------------------------------------
# AWS (used by Go backend, not directly by Next.js in prod)
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Deployment notes
# ---------------------------------------------------------------------------
# Vercel (frontend only):
#   Required: SENTINEL_JIT_SECRET, DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD,
#             DEMO_ADMIN_NAME, SENTINEL_API_URL
#   Optional: ABUSEIPDB_KEY, VT_KEY, GREYNOISE_KEY, OTX_KEY, STRIPE_WEBHOOK_SECRET
#
# AWS EC2 / App Runner (Go backend /api):
#   Required: SENTINEL_JIT_SECRET, DATABASE_URL, AWS_REGION
#   Optional: ABUSEIPDB_KEY, VT_KEY, GREYNOISE_KEY, OTX_KEY,
#             ALERT_SES_FROM_EMAIL, SCAN_QUEUE_URL, ALLOWED_ORIGINS
