# Tricognita Frontend — local development environment template.
#
# Copy this file to .env.local and replace every "change-me" value.
# Never commit .env.local or any file containing real secrets.
#
# All "change-me" placeholders below are intentionally invalid so the
# platform fails fast at startup if you forget to substitute them.

# ── HMAC signing secret (REQUIRED) ────────────────────────────────────────────
# Used to sign session cookies + mint JIT tokens to the Go API.
# Minimum 32 bytes; enforced at startup. Generate with:
#   openssl rand -base64 48
SENTINEL_JIT_SECRET=change-me-min-32-bytes-xxxxxxxxxxxxxxx

# ── Session signing secret (REQUIRED) ─────────────────────────────────────────
# Same length requirement as SENTINEL_JIT_SECRET.
SESSION_SECRET=change-me-min-32-bytes-xxxxxxxxxxxxxxx

# ── Bootstrap reset token (REQUIRED) ──────────────────────────────────────────
# Used by the one-time /api/auth/bootstrap-reset flow. Rotate after every use.
BOOTSTRAP_RESET_TOKEN=change-me-min-24-bytes-xxxxxxxxxxxxx

# ── Demo admin (REQUIRED for first-run admin creation) ────────────────────────
# Written to frontend/.data/users.json on first start if no admin exists.
# Password must be >= 12 characters. Use a strong value; this is a real
# login that can do anything.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-strong-admin-password
DEMO_ADMIN_NAME=Local Admin

# ── Go API endpoint (REQUIRED for any cloud workflow) ─────────────────────────
# For local development, point this at your Go API instance.
# In production deployments this MUST be set; an unset value fails closed.
SENTINEL_API_URL=http://localhost:8787

# ── Data source (defaults to fixtures outside production) ─────────────────────
# lib/data/source.ts: any non-production build (including `next dev`) renders
# lib/fixtures/ synthetic data — with a visible "Demo data" banner — unless
# this is set to "api". Set it to see real data from SENTINEL_API_URL while
# developing or rehearsing against a real backend. A production build always
# uses the real API regardless of this value (and refuses to start if this is
# explicitly set to "fixtures").
NEXT_PUBLIC_DATA_SOURCE=api

# ── Upstash Redis (RECOMMENDED — many features degrade without it) ────────────
# Without Redis: notifications, webhooks, incidents, feedback, telemetry,
# and usage accounting all fail open (logged warnings, no data persistence).
# See docs/SECURITY_REVIEW.md and PRICING_MODEL.md for details on which
# features depend on Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Postgres (RECOMMENDED) ────────────────────────────────────────────────────
# Required for persistent user accounts beyond the demo admin.
DATABASE_URL=

# ── Cron secret (RECOMMENDED for production) ──────────────────────────────────
# Bearer token required by /api/admin/webhook-drain.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── CSRF dev origins (OPTIONAL — local development only) ──────────────────────
# middleware.ts rejects any state-changing /api/* request (POST/PUT/DELETE/
# PATCH) whose browser-sent Origin header isn't in its allowlist. Production
# always accepts only https://tricognita.com and https://www.tricognita.com —
# that default is hardcoded in lib/csrf-origins.ts and cannot be changed by
# this or any other environment variable.
#
# To exercise the real login/CSRF path from a real browser against a local
# `next dev` server, explicitly list the exact origin(s) it's served from
# (scheme + host + port, comma-separated, no wildcards):
#   CSRF_DEV_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
#
# This is read ONLY when NODE_ENV is not "production" (next build/start set
# it to "production" unconditionally) — set anywhere else, including in a
# production environment's config by mistake, it has no effect. Leave unset
# and CSRF still fails closed exactly as before this variable existed.
CSRF_DEV_ORIGINS=

# ── Vercel-injected release metadata (auto-populated on Vercel) ───────────────
# Safe to leave blank locally; the dashboard footer falls back to "dev".
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF=
# NEXT_PUBLIC_VERCEL_ENV=development
# NEXT_PUBLIC_DEPLOY_TIMESTAMP=
# ── Demo mode (OPTIONAL — ephemeral demo deployments only) ────────────────────
# When true, the dashboard renders synthetic data from lib/demo-data.ts
# instead of making real API calls. Auth and RBAC remain enforced.
# NEVER set this to true on production deployments with real customer data.
# To activate: copy to .env.local and set to true, or set in Vercel env vars
# for an ephemeral demo deployment.
NEXT_PUBLIC_DEMO_MODE=false

# ── Additional variables read by the frontend (names only — never commit values)
# Server-only unless prefixed NEXT_PUBLIC_. Leave blank locally unless needed.
#
# Upstash via the Vercel KV integration (either pair is accepted; KV_* first
# in some routes, UPSTASH_* first in others).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Session revocation when Redis is unreachable: "true" fails closed.
REVOCATION_FAIL_CLOSED=
# User store backend: "file" or "memory" (default: file outside serverless).
USERS_STORE=
# "postgres" verifies logins against the Go API identity endpoint.
IDENTITY_SOURCE=
# Server-to-server key for the Go identity endpoint (IDENTITY_SOURCE=postgres).
INTERNAL_SERVICE_KEY=
# "true" permits self-service registration (disabled by default).
ENABLE_OPEN_REGISTRATION=
# Server-side demo switch; /api/admin/demo-reset requires "true".
DEMO_MODE=
# Inbox that receives contact / lead notifications.
CONTACT_TO_EMAIL=
# Datasets bucket name for the system-health check (any one of the three).
AWS_S3_BUCKET=
DATASETS_S3_BUCKET=
S3_DATASETS_BUCKET=
# Release timestamp fallback when NEXT_PUBLIC_DEPLOY_TIMESTAMP is unset.
DEPLOY_TIMESTAMP=
# Deprecated alias of SENTINEL_API_URL; migrate to SENTINEL_API_URL.
ARIA_BACKEND_URL=
#
# Public (client-safe) — inlined into the browser bundle at build time.
# Base URL used in outbound links (e.g. Slack notifications).
NEXT_PUBLIC_DASHBOARD_BASE_URL=
# "true" opens the demo /dashboard/executive page outside dev.
NEXT_PUBLIC_ENABLE_DEMO_EXECUTIVE=
